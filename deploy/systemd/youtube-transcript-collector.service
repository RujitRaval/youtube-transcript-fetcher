[Unit]
Description=Collect YouTube transcripts locally
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@@PROJECT@@
ExecStart=@@PYTHON@@ -m youtube_transcript_collector --config @@CONFIG@@ --log-file @@LOG@@ run
UMask=0077
TimeoutStartSec=45min
NoNewPrivileges=true
